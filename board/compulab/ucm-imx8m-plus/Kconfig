if TARGET_UCM_IMX8M_PLUS

config SYS_BOARD
	default "ucm-imx8m-plus"

config SYS_VENDOR
	default "compulab"

config SYS_CONFIG_NAME
	default "ucm-imx8m-plus"

config DEFAULT_FDT_FILE
	string
	default "ucm-imx8m-plus.dtb" if !SBEV_UCMIMX8PLUS
	default "sbev-ucmimx8plus.dtb" if SBEV_UCMIMX8PLUS

config DEFAULT_DEVICE_TREE
	default "ucm-imx8m-plus"

config SYS_I2C_EEPROM_BUS
	int
	default 1

config SYS_I2C_EEPROM_ADDR
	hex
	default 0x50

config SYS_I2C_EEPROM_BUS_SB
	hex
	default 0x1 if !SBEV_UCMIMX8PLUS
	default 0x2 if SBEV_UCMIMX8PLUS

config SYS_I2C_EEPROM_ADDR_SB
	hex
	default 0x54

config IMX_CONFIG
	default "board/freescale/imx8mp_evk/imximage-8mp-lpddr4.cfg"

config SBEV_UCMIMX8PLUS
	bool "CompuLab SBEV-UCMIMX8PLUS Support"
	default n

config COMPULAB_DEBUG_UART4
	bool "System Debug UART4"
	default n

config COMPULAB_LPDDR4_MRR_PROBE
	bool "Experimental LPDDR4 identification before timing training"
	depends on SPL && IMX8M_LPDDR4 && !SPL_OS_BOOT
	help
	  Try a 100 MT/s device/PHY initialization-only firmware pass in SPL
	  and read MR5-MR8 before choosing the full training profile. Uses
	  the CompuLab Samsung 2GB profile's low-frequency point as a seed;
	  board wiring and PHY firmware compatibility require validation.
	  Ambiguous IDs, inconsistent reads and timeouts fall back to the
	  existing discovery procedure. EEPROM is updated only after full
	  training and ID verification. Disabled by default.

config COMPULAB_LPDDR4_MRR_PROBE_ALWAYS
	bool "Also probe when EEPROM already identifies the DRAM"
	depends on COMPULAB_LPDDR4_MRR_PROBE
	help
	  Run the experimental MRR probe even on boards with valid cached
	  identification, for hardware validation without erasing EEPROM.
	  A valid EEPROM profile still determines full training. Resets in
	  an ongoing discovery scan skip the probe to avoid retry loops.

endif
