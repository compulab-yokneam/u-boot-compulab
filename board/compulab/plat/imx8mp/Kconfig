menu  "Compulab i.MX8MP platform features"
	depends on TARGET_UCM_IMX8M_PLUS

choice
	prompt  "CompuLab i.MX8MP dram options"
	default IMX8MP_DRAM_D2

config IMX8MP_DRAM_D2
	bool "Enable D2 dram support"
	help
	  If 'Y' then support for D2 is enabled

config IMX8MP_DRAM_D4
	bool "Enable D4 dram support"
	help
	  If 'Y' then support for D1 is enabled

config IMX8MP_DRAM_D1D8
	bool "Enable D1D8"
	help
	If 'Y' then support for D1 and D8 configuration is enabled

endchoice

config ATF_LOAD_ADDR
	hex
	default 0x00970000

config TEE_LOAD_ADDR
	hex
	default 0x56000000

config LAB_TEMPERATURE_RANGE_WARNING
	bool "Warn about laboratory temperature range"
	depends on LAB_TEMPERATURE_RANGE

endmenu
