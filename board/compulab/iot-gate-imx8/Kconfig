if TARGET_IOT_GATE_IMX8

config SYS_BOARD
	default "iot-gate-imx8"

config SYS_VENDOR
	default "compulab"

config SYS_CONFIG_NAME
	default "iot-gate-imx8"

config DEFAULT_FDT_FILE
	string
	depends on TARGET_IOT_GATE_IMX8
	default ""

config FASTBOOT_DEBUG
	bool
	default n
	help
	  Enable fastboot as a fallback instruction, instead of UMS

config SYS_PROMPT
	string
	default "IOT-GATE-iMX8[fb] => " if FASTBOOT_DEBUG
	default "IOT-GATE-iMX8 => " if !FASTBOOT_DEBUG
endif
