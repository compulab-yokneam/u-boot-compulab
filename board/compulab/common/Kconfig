config EXPORT_ENV_DEF_VIA_DT  
	bool "Export default environment block via device tree"
	default y
	help
	  Export content of the default environment array (compiled in the u-boot)
          as a device tree node fw_env/default_env


config LAB_TEMPERATURE_RANGE
	bool "Extend temperature range"
	default n
	help
		Never say yes, unless you are Compulab emploee

config LAB_TEMPERATURE_RANGE_WARNING
	bool "Extend temperature range warning"
	default n
	depends on LAB_TEMPERATURE_RANGE
	help
		Never say yes, unless you are Compulab emploee

