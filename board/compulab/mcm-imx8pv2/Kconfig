if TARGET_MCM_IMX8PV2

config SYS_BOARD
	default "mcm-imx8pv2"

config SYS_VENDOR
	default "compulab"

config SYS_CONFIG_NAME
	default "mcm-imx8pv2"

config DEFAULT_DTB
	string
	default "mcm-imx8pv2.dtb"

config DEFAULT_FDT_FILE
	string
	default "mcm-imx8pv2.dtb"

config DEFAULT_DEVICE_TREE
	string
	default "mcm-imx8pv2"

config SYS_I2C_EEPROM_BUS
	int
	default 1

config SYS_I2C_EEPROM_ADDR
	hex
	default 0x50

# SBC-MCM8PV2 carrier EEPROM on I2C3.
config SYS_I2C_EEPROM_BUS_SB
	hex
	default 0x2

config SYS_I2C_EEPROM_ADDR_SB
	hex
	default 0x54

endif
