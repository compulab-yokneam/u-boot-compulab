# Target settings for iot-gate-imx8pv2.
# Merge after configs/compulab-imx8mp_defconfig.
CONFIG_TARGET_IOT_GATE_IMX8PV2=y
CONFIG_BOOTCOMMAND="run bsp_bootcmd"
CONFIG_CMD_TPM=y
CONFIG_USE_ETHPRIME=y
CONFIG_ETHPRIME="eth0"
CONFIG_DM_SPI_FLASH=y
CONFIG_SF_DEFAULT_MODE=0
CONFIG_SF_DEFAULT_SPEED=40000000
CONFIG_SPI_FLASH_BAR=y
CONFIG_SPI_FLASH_WINBOND=y
CONFIG_RTC_ABX80X=y
CONFIG_DM_SPI=y
CONFIG_NXP_FSPI=y
CONFIG_TPM2_TIS_I2C=y
CONFIG_VIDEO=y
CONFIG_VIDEO_LOGO=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_VIDEO_IMX8MP_LVDS=y
CONFIG_VIDEO_IMX8MP_HDMI=y
CONFIG_VIDEO_IMX_SEC_DSI=y
CONFIG_VIDEO_IMX_LCDIFV3=y
CONFIG_SPLASH_SCREEN=y
CONFIG_SPLASH_SCREEN_ALIGN=y
CONFIG_BMP_16BPP=y
CONFIG_BMP_24BPP=y
CONFIG_BMP_32BPP=y
CONFIG_TPM=y
