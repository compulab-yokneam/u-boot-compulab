# Target settings for mcm-imx8pv2.
# Merge after configs/compulab-imx8mp_defconfig.
CONFIG_TARGET_MCM_IMX8PV2=y
CONFIG_ENV_MMC_DEVICE_INDEX=2
CONFIG_BOOTCOMMAND="run distro_bootcmd;run bsp_bootcmd"
CONFIG_RTC_RX8010SJ=y
CONFIG_PHY_MICREL=y
CONFIG_PHY_MICREL_KSZ90X1=y
CONFIG_DM_PWM=y
CONFIG_PWM_IMX=y
CONFIG_VIDEO=y
CONFIG_VIDEO_LOGO=y
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_PANEL=y
CONFIG_SIMPLE_PANEL=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_VIDEO_LCD_STARTEK_ILI9881C=y
CONFIG_VIDEO_IMX8MP_LVDS=y
CONFIG_VIDEO_IMX8MP_HDMI=y
CONFIG_VIDEO_IMX_SEC_DSI=y
CONFIG_VIDEO_IMX_LCDIFV3=y
CONFIG_SPLASH_SCREEN=y
CONFIG_SPLASH_SCREEN_ALIGN=y
CONFIG_BMP_16BPP=y
CONFIG_BMP_24BPP=y
CONFIG_BMP_32BPP=y
